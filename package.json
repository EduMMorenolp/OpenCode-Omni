{
  "name": "opencode-omni",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,green \"node --watch backend/src/index.js\" \"cd frontend && npx vite\"",
    "dev:backend": "node --watch backend/src/index.js",
    "dev:frontend": "cd frontend && npx vite",
    "build": "cd frontend && npm run build",
    "start": "node backend/src/index.js",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
