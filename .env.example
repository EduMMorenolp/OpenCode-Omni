# Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_botfather

# OpenCode
OPENCODE_PASSWORD=segura_contraseña
JWT_SECRET=otro_secreto

# Admin (para login en Dashboard y API)
ADMIN_PASSWORD=admin123

# Chat ID de Telegram para recibir alertas del sistema (opcional)
ADMIN_CHAT_ID=

# Puertos
BACKEND_PORT=3021
FRONTEND_PORT=5399

# Ngrok (para webhook Telegram)
NGROK_AUTHTOKEN=tu_ngrok_token

# Zona horaria
TZ=America/Argentina/Buenos_Aires

# Provider de OpenCode (ej: LaLlamaOllama)
OPENCODE_PROVIDER_URL=http://host.docker.internal:3016/v1
OPENCODE_PROVIDER_NAME=lallamaollama
OPENCODE_MODEL=llama3.2:3b
